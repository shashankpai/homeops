{
  "__inputs": [],
  "annotations": { "list": [] },
  "editable": true,
  "graphTooltip": 1,
  "id": null,
  "links": [],
  "panels": [
    {
      "datasource": { "type": "prometheus", "uid": "${DS_PROMETHEUS}" },
      "description": "THE data point we follow all the way down to /proc/meminfo. Zoom in: 15 seconds between dots — the smooth line is Grafana painting between samples. Every dot = one intact chain of custody: kernel counter, translated, scraped, stored, queried.",
      "fieldConfig": {
        "defaults": {
          "custom": { "drawStyle": "line", "fillOpacity": 15, "lineWidth": 2, "pointSize": 8, "showPoints": "never", "spanNulls": true },
          "unit": "bytes"
        },
        "overrides": []
      },
      "gridPos": { "h": 9, "w": 16, "x": 0, "y": 0 },
      "id": 1,
      "options": { "legend": { "displayMode": "list", "placement": "bottom", "showLegend": true }, "tooltip": { "mode": "multi" } },
      "targets": [
        {
          "datasource": { "type": "prometheus", "uid": "${DS_PROMETHEUS}" },
          "expr": "node_memory_MemAvailable_bytes",
          "legendFormat": "{{instance}}",
          "refId": "A"
        }
      ],
      "title": "The Data Point — node_memory_MemAvailable_bytes (six links of custody, intact)",
      "type": "timeseries"
    },
    {
      "datasource": { "type": "prometheus", "uid": "${DS_PROMETHEUS}" },
      "description": "Link 3, working — and how hard. up = the delivery receipt (Prometheus writes it per scrape; 1 = last delivery succeeded). scrape_duration = how long the run took; when a target gets too heavy it climbs toward the 15s interval and up flips to 0 — the birth of graph holes (Episode 07).",
      "fieldConfig": {
        "defaults": {
          "custom": { "drawStyle": "line", "fillOpacity": 0, "lineWidth": 2, "pointSize": 4, "showPoints": "never", "spanNulls": true },
          "thresholds": { "mode": "absolute", "steps": [ { "color": "red", "value": null }, { "color": "green", "value": 1 } ] },
          "unit": "bool"
        },
        "overrides": [
          {
            "matcher": { "id": "byName", "options": "max scrape duration (s)" },
            "properties": [
              { "id": "unit", "value": "s" },
              { "id": "thresholds", "value": { "mode": "absolute", "steps": [ { "color": "green", "value": null }, { "color": "orange", "value": 1 }, { "color": "red", "value": 10 } ] } }
            ]
          }
        ]
      },
      "gridPos": { "h": 9, "w": 8, "x": 16, "y": 0 },
      "id": 2,
      "options": { "legend": { "displayMode": "list", "placement": "bottom", "showLegend": true }, "tooltip": { "mode": "multi" } },
      "targets": [
        {
          "datasource": { "type": "prometheus", "uid": "${DS_PROMETHEUS}" },
          "expr": "up{job=\"node-exporter\"}",
          "legendFormat": "up ({{instance}})",
          "refId": "A"
        },
        {
          "datasource": { "type": "prometheus", "uid": "${DS_PROMETHEUS}" },
          "expr": "max(scrape_duration_seconds{job=\"node-exporter\"})",
          "legendFormat": "max scrape duration (s)",
          "refId": "B"
        }
      ],
      "title": "Delivery Health — the scrape (Link 3)",
      "type": "timeseries"
    },
    {
      "datasource": { "type": "prometheus", "uid": "${DS_PROMETHEUS}" },
      "description": "Link 4's population: unique series currently memory-resident in the head block. Memory usage tracks this number almost linearly — the single most important Prometheus metric, and the exact lever Episode 04 (Cardinality Explosion) pulls.",
      "fieldConfig": {
        "defaults": {
          "custom": { "drawStyle": "line", "fillOpacity": 10, "lineWidth": 2, "showPoints": "never", "spanNulls": true },
          "decimals": 0,
          "min": 0,
          "unit": "short"
        },
        "overrides": []
      },
      "gridPos": { "h": 8, "w": 12, "x": 0, "y": 9 },
      "id": 3,
      "options": { "legend": { "displayMode": "hidden" }, "tooltip": { "mode": "single" } },
      "targets": [
        {
          "datasource": { "type": "prometheus", "uid": "${DS_PROMETHEUS}" },
          "expr": "prometheus_tsdb_head_series",
          "legendFormat": "head series",
          "refId": "A"
        }
      ],
      "title": "The Vault's Population — head series (Link 4)",
      "type": "timeseries"
    },
    {
      "datasource": { "type": "prometheus", "uid": "${DS_PROMETHEUS}" },
      "description": "The pipeline's heartbeat: samples per second flowing into the vault. This is monitoring's true cost, in data points/second. Run an episode demo and watch it step up — the delta is that demo's metric footprint.",
      "fieldConfig": {
        "defaults": {
          "custom": { "drawStyle": "line", "fillOpacity": 25, "lineWidth": 2, "showPoints": "never", "spanNulls": true },
          "min": 0,
          "unit": "ops"
        },
        "overrides": []
      },
      "gridPos": { "h": 8, "w": 12, "x": 12, "y": 9 },
      "id": 4,
      "options": { "legend": { "displayMode": "hidden" }, "tooltip": { "mode": "single" } },
      "targets": [
        {
          "datasource": { "type": "prometheus", "uid": "${DS_PROMETHEUS}" },
          "expr": "rate(prometheus_tsdb_head_samples_appended_total[1m])",
          "legendFormat": "samples/sec appended",
          "refId": "A"
        }
      ],
      "title": "The Pipeline Heartbeat — ingestion rate (Link 4)",
      "type": "timeseries"
    }
  ],
