{
  "__inputs": [],
  "annotations": { "list": [] },
  "editable": true,
  "graphTooltip": 1,
  "id": null,
  "links": [],
  "panels": [
    {
      "datasource": { "type": "prometheus", "uid": "${DS_PROMETHEUS}" },
      "description": "THE triage panel: 1 = last death was OOMKilled (kernel, container limit); 1 on the other series = CrashLoopBackOff (the app itself). Same 'pod is broken' symptom, completely different diagnosis path. 30 seconds of reading this panel replaces minutes of guessing.",
      "fieldConfig": {
        "defaults": {
          "custom": { "drawStyle": "line", "fillOpacity": 40, "lineWidth": 2, "showPoints": "always", "spanNulls": true },
          "decimals": 0,
          "max": 1,
          "min": 0,
          "thresholds": { "mode": "absolute", "steps": [ { "color": "green", "value": null }, { "color": "red", "value": 1 } ] }
        },
        "overrides": []
      },
      "gridPos": { "h": 8, "w": 12, "x": 0, "y": 0 },
      "id": 1,
      "options": { "legend": { "displayMode": "list", "placement": "bottom", "showLegend": true }, "tooltip": { "mode": "multi" } },
      "targets": [
        {
          "datasource": { "type": "prometheus", "uid": "${DS_PROMETHEUS}" },
          "expr": "kube_pod_container_status_last_terminated_reason{namespace=\"shopnow\", reason=\"OOMKilled\"}",
          "legendFormat": "OOMKilled ({{pod}})",
          "refId": "A"
        },
        {
          "datasource": { "type": "prometheus", "uid": "${DS_PROMETHEUS}" },
          "expr": "kube_pod_container_status_waiting_reason{namespace=\"crashloop-demo\", reason=\"CrashLoopBackOff\"}",
          "legendFormat": "CrashLoopBackOff ({{pod}})",
          "refId": "B"
        }
      ],
      "title": "Triage: OOMKilled vs CrashLoopBackOff (the 30-second fork)",
      "type": "timeseries"
    },
    {
      "datasource": { "type": "prometheus", "uid": "${DS_PROMETHEUS}" },
      "description": "Restart counters — the heartbeat of 'dying repeatedly'. payment-service steps once per OOMKill; crashy steps every backoff cycle (10s, 20s, 40s...). Different step patterns = different families.",
      "fieldConfig": {
        "defaults": {
          "custom": { "drawStyle": "line", "fillOpacity": 10, "lineWidth": 2, "showPoints": "never", "stepAfter": true },
          "decimals": 0,
          "min": 0
        },
        "overrides": []
      },
      "gridPos": { "h": 8, "w": 12, "x": 12, "y": 0 },
      "id": 2,
      "options": { "legend": { "displayMode": "list", "placement": "bottom", "showLegend": true }, "tooltip": { "mode": "multi" } },
      "targets": [
        {
          "datasource": { "type": "prometheus", "uid": "${DS_PROMETHEUS}" },
          "expr": "kube_pod_container_status_restarts_total{namespace=~\"shopnow|crashloop-demo\"}",
          "legendFormat": "restarts ({{pod}})",
          "refId": "A"
        }
      ],
      "title": "Restart Counters (both victims)",
      "type": "timeseries"
    },
    {
      "datasource": { "type": "prometheus", "uid": "${DS_PROMETHEUS}" },
      "description": "The autopsy: working set climbing to the 128Mi limit and falling off the cliff at the kill. Read diagnostically: how long was the runway? Was the climb linear (leak) or plateauing (under-sized)?",
      "fieldConfig": {
        "defaults": {
          "custom": { "drawStyle": "line", "fillOpacity": 15, "lineWidth": 2, "pointSize": 5, "showPoints": "never", "spanNulls": true },
          "unit": "bytes"
        },
        "overrides": [
          {
            "matcher": { "id": "byName", "options": "limit" },
            "properties": [
              { "id": "custom.fillOpacity", "value": 0 },
              { "id": "custom.lineStyle", "value": { "dash": [10, 10], "fill": "dash" } },
              { "id": "color", "value": { "mode": "fixed", "fixedColor": "red" } }
            ]
          }
        ]
      },
      "gridPos": { "h": 9, "w": 16, "x": 0, "y": 8 },
      "id": 3,
      "options": { "legend": { "displayMode": "list", "placement": "bottom", "showLegend": true }, "tooltip": { "mode": "multi" } },
      "targets": [
        {
          "datasource": { "type": "prometheus", "uid": "${DS_PROMETHEUS}" },
          "expr": "container_memory_working_set_bytes{namespace=\"shopnow\", container=\"payment-service\"}",
          "legendFormat": "working set ({{pod}})",
          "refId": "A"
        },
        {
          "datasource": { "type": "prometheus", "uid": "${DS_PROMETHEUS}" },
          "expr": "container_spec_memory_limit_bytes{namespace=\"shopnow\", container=\"payment-service\"}",
          "legendFormat": "limit",
          "refId": "B"
        }
      ],
      "title": "The Autopsy: Working Set vs Limit (how close, how fast)",
      "type": "timeseries"
    },
    {
      "datasource": { "type": "prometheus", "uid": "${DS_PROMETHEUS}" },
      "description": "Percent of limit. Sustained above 90% (the orange line) = your future OOMKill. This gauge is the early-warning threshold Episode 4 turns into a firing alert.",
      "fieldConfig": {
        "defaults": {
          "custom": { "drawStyle": "line", "fillOpacity": 25, "lineWidth": 2, "showPoints": "never" },
          "max": 130,
          "min": 0,
          "thresholds": { "mode": "absolute", "steps": [ { "color": "green", "value": null }, { "color": "orange", "value": 70 }, { "color": "red", "value": 90 } ] },
          "unit": "percent"
        },
        "overrides": []
      },
      "gridPos": { "h": 9, "w": 8, "x": 16, "y": 8 },
      "id": 4,
      "options": { "legend": { "displayMode": "hidden" }, "tooltip": { "mode": "single" } },
      "targets": [
        {
          "datasource": { "type": "prometheus", "uid": "${DS_PROMETHEUS}" },
          "expr": "100 * container_memory_working_set_bytes{namespace=\"shopnow\", container=\"payment-service\"} / container_spec_memory_limit_bytes{namespace=\"shopnow\", container=\"payment-service\"}",
          "legendFormat": "% of limit",
          "refId": "A"
        }
      ],
      "title": "Usage vs Limit (%) — 90% = future OOMKill",
      "type": "timeseries"
    },
    {
      "datasource": { "type": "prometheus", "uid": "${DS_PROMETHEUS}" },
      "description": "The fix decider: rate of working-set growth in bytes/second. Linear positive that never flattens = LEAK (fix the app). Falling to ~0 = plateau (legit cache — right-size instead). One query decides which fix path you take.",
      "fieldConfig": {
        "defaults": {
          "custom": { "drawStyle": "line", "fillOpacity": 30, "lineWidth": 2, "showPoints": "never", "spanNulls": true },
          "unit": "Bps"
        },
        "overrides": []
      },
      "gridPos": { "h": 8, "w": 24, "x": 0, "y": 17 },
      "id": 5,
      "options": { "legend": { "displayMode": "hidden" }, "tooltip": { "mode": "single" } },
      "targets": [
        {
          "datasource": { "type": "prometheus", "uid": "${DS_PROMETHEUS}" },
          "expr": "deriv(container_memory_working_set_bytes{namespace=\"shopnow\", container=\"payment-service\"}[5m])",
          "legendFormat": "working set growth rate",
          "refId": "A"
        }
      ],
      "title": "Leak Signature: Working Set Growth Rate (deriv, 5m)",
      "type": "timeseries"
    }
  ],
  "refresh": "5s",
  "schemaVersion": 39,
  "tags": ["k8s-under-the-hood", "episode-3", "diagnosis"],
  "templating": {
    "list": [
      {
        "current": {},
        "hide": 0,
        "label": "Prometheus",
        "name": "DS_PROMETHEUS",
        "options": [],
        "query": "prometheus",
        "refresh": 1,
        "regex": "",
        "type": "datasource"
      }
    ]
  },
  "time": { "from": "now-30m", "to": "now" },
  "timezone": "browser",
  "title": "Episode 3 — OOMKill Diagnosis",
  "uid": "ep03-diag",
  "version": 1
}
